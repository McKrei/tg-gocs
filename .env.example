# === НАСТРОЙКИ TELEGRAM БОТА ===
# Токен бота от BotFather
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
# ID Telegram-чата (группы), в котором работает бот. Все участники группы получают доступ автоматически.
# Узнать ID: добавить @userinfobot в группу и написать /start
ALLOWED_CHAT_IDS=-1002042745192

# === НАСТРОЙКИ LLM И EMBEDDINGS (OPENROUTER) ===
# API ключ OpenRouter
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Модель для обработки документов (Vision, Chat, Agent)
LLM_MODEL=google/gemini-3.5-flash
# Модель для генерации векторных эмбеддингов
EMBEDDING_MODEL=google/gemini-embedding-2
# Базовый URL OpenRouter
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Лимит результатов поиска и порог косинусного расстояния (0.30 = 70% схожести)
SEARCH_LIMIT=10
SEARCH_THRESHOLD=0.30

# === НАСТРОЙКИ БАЗЫ ДАННЫХ ===
# Путь к файлу базы данных SQLite
DB_PATH=data/sqlite.db

# === НАСТРОЙКИ ХРАНИЛИЩА ===
# Путь к локальной директории для сохранения итоговых документов.
# Оставьте пустым, если хотите хранить документы только в Google Drive (рекомендуется для сервера).
LOCAL_STORAGE_DIR=
# Путь к временной директории для обработки входящих файлов
TEMP_DIR=data/temp
# Путь к файлу авторизации Google Service Account (для обратной совместимости)
GDRIVE_CREDENTIALS_PATH=data/credentials.json
# Путь к файлу токена авторизации Google OAuth 2.0 (рекомендуется)
GDRIVE_TOKEN_PATH=data/token.json
# ID корневой папки в Google Drive, куда бот будет сохранять документы
GDRIVE_ROOT_FOLDER_ID=1_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ID папки "Inbox" в Google Drive — место для новых необработанных документов (опционально).
# Если задан, бот будет предлагать обработать файлы из этой папки по команде /inbox.
GDRIVE_INBOX_FOLDER_ID=
